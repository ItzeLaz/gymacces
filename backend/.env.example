PORT=3000
NODE_ENV=development

# Conexión a MySQL / MariaDB local
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=gym_access
DB_NAME_TEST=gym_access_test

# Autenticación: el secreto debe tener al menos 32 caracteres
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origen permitido del frontend
CORS_ORIGIN=http://localhost:5173

# Reconocimiento facial (research R-05, R-06 y R-14)
# Llave AES-256 en base64 (32 bytes) para cifrar los descriptores faciales. Genérala con:
#   node -e "import('node:crypto').then((c) => console.log(c.randomBytes(32).toString('base64')))"
# Resguárdala: si se pierde o se cambia, hay que volver a registrar los rostros de todos los clientes.
FACE_DATA_KEY=
# Similitud mínima (0 a 1) para aceptar una coincidencia; se ajusta en la calibración
FACE_MATCH_THRESHOLD=0.60
# Diferencia mínima frente al segundo cliente más parecido para evitar confusiones
FACE_MATCH_MARGIN=0.05

# Control de acceso
# Segundos en los que no se repite el registro del mismo cliente con el mismo resultado
ACCESS_DEDUP_SECONDS=10
# Zona horaria del gimnasio para decidir la vigencia de las membresías
APP_TIMEZONE=America/Mexico_City
